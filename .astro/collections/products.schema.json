{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "agarwood",
        "mala"
      ]
    },
    "price": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category"
  ]
}